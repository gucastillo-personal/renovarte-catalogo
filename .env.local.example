# Copiar a `.env.local` (gitignored) y completar los valores reales.

# URL pública (wss://) del WebSocket de "Colibrí" (spec 0016,
# renovarte-chat-gateway) — nunca un secreto, es la misma URL que ya queda
# visible en el tráfico de red del navegador (AC-10/AC-12). Sin este valor
# el chat entra directo al estado "no disponible" (razón local
# "connection_error"), el resto del catálogo sigue funcionando igual
# (AC-11). Vacío hasta que renovarte-chat-gateway esté desplegado.
NEXT_PUBLIC_CHAT_WS_URL=

# URL pública (https://) de la Function URL de `renovarte-ordenes` (spec 0017,
# envío de la orden de compra) — nunca un secreto, es la misma URL que queda
# visible en el tráfico de red del navegador. Sin este valor el carrito, la
# ficha y el resto del catálogo funcionan igual, pero "Enviar orden" falla con
# el aviso de "no se envió" y los canales directos (teléfono, mail, Instagram).
# Para desarrollar contra el servidor local de ese repo:
# NEXT_PUBLIC_ORDERS_API_URL=http://localhost:8787
NEXT_PUBLIC_ORDERS_API_URL=
