# RenovArte catalog — environment
#
# These variables are read ONLY by the local ingest script (scripts/ingest.ts,
# spec 0002). They must NOT use the NEXT_PUBLIC_ prefix and must NOT be set in
# Vercel — doing so would ship cost/margin signal to the browser (RFC-0001 §2.3,
# PRD RNF-03).
#
# Copy to `.env.local` (gitignored) and adjust before running `pnpm ingest`.

# Default margin applied over cost, as a percentage.
MARGIN_PERCENT_DEFAULT=20

# Optional per-category overrides. Key = MARGIN_PERCENT_<CATEGORY>, category
# upper-cased with spaces replaced by "_".
# MARGIN_PERCENT_ANTIAGE=30
